# Copy to .env and adjust. .env is gitignored; this example file is committed.
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
MANIFEST_PATH=data/manifest.csv
CHROMA_DIR=data/chroma

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# cpu | mps (Apple GPU) | cuda. mps crashes with torch 2.15 on macOS 14, so cpu is the default.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# bge expects this instruction before QUERIES only (never before documents).
QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# 256 = default; 510 = the large setting compared in M4 (max for bge-small: 512 minus [CLS]/[SEP])
CHUNK_SIZE=256
CHUNK_OVERLAP=40
TOP_K=5

LOG_LEVEL=INFO

# Use the local Hugging Face cache only (no network calls) once models are downloaded.
# HF_HUB_OFFLINE=1

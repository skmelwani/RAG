# Copy to .env and adjust. .env is gitignored; this example file is committed.
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
MANIFEST_PATH=data/manifest.csv
CHROMA_DIR=data/chroma

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# cpu | mps (Apple GPU) | cuda. mps crashes with torch 2.15 on macOS 14, so cpu is the default.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# bge expects this instruction before QUERIES only (never before documents).
QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# 256 = default; 510 = the large setting compared in M4 (max for bge-small: 512 minus [CLS]/[SEP])
CHUNK_SIZE=256
CHUNK_OVERLAP=40
TOP_K=5
# If the best chunk's cosine similarity is below this, refuse without calling the LLM.
# bge-small scores are compressed: off-topic questions ~0.45-0.51, in-domain >= 0.65.
# Starting value; tuned in M4 with the evaluation set.
MIN_SCORE=0.55

# LLM served by Ollama (installed natively). In docker-compose (M9) this becomes http://ollama:11434
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
# 0 = deterministic answers, so evaluation runs are repeatable.
LLM_TEMPERATURE=0.0
# Context window in tokens. Ollama silently drops the start of longer prompts (= the rules!).
LLM_NUM_CTX=4096
# Seconds. The first request also loads the model into RAM, so it is slow.
LLM_TIMEOUT=120

LOG_LEVEL=INFO

# Use the local Hugging Face cache only (no network calls) once models are downloaded.
# HF_HUB_OFFLINE=1
